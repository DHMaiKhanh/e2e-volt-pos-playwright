{
  "name": "e2e-volt-pos-test",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright E2E automation framework for the Volt POS app",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky install",
    "setup": "npm install && npx playwright install chromium",
    "postinstall": "playwright install --with-deps chromium",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "reports:index": "node scripts/build-reports-index.mjs",
    "dashboard": "node scripts/run-dashboard.mjs",
    "//dashboard": "`dashboard` runs the FULL suite first (~477 tests incl. every @slow scan, the 60-day V1-vs-V2 sweep and the portal SSO project) — tens of minutes. `dashboard:fast` runs the PR lane instead (~3 min) and builds the same dashboard.",
    "dashboard:fast": "cross-env LANE=fast node scripts/run-dashboard.mjs --project=chromium --project=no-retry --project=api --grep-invert \"@slow|@exclusive\"",
    "dashboard:build": "node scripts/build-dashboard.mjs",
    "pretest": "node scripts/check-server.mjs",
    "test": "cross-env ENV=local playwright test",
    "test:local": "cross-env ENV=local playwright test",
    "//lanes": "test:pr = the PR gate (fast parallel bulk, then the serial tail) + the merged dashboard. test:full = everything, nightly. See docs/test-performance-optimization.md",
    "test:pr": "node scripts/run-pr-dashboard.mjs",
    "//test:pr": "Runs both lanes with REPORT_SLICE so neither overwrites the other's artifacts, merges them into reports/dashboard/index.html and opens it. Exit code is still the gate. Flags: --no-open, --bail, plus any Playwright args after `--`.",
    "test:pr:lanes": "npm run test:fast && npm run test:serial",
    "test:fast": "cross-env ENV=local LANE=fast playwright test --project=chromium --project=no-retry --project=api --grep-invert \"@slow|@exclusive\"",
    "test:serial": "cross-env ENV=local LANE=fast playwright test --project=chromium --project=no-retry --project=serial --grep \"@exclusive\" --workers=1",
    "test:full": "cross-env ENV=local LANE=full playwright test",
    "test:slow": "cross-env ENV=local LANE=full playwright test --grep \"@slow\"",
    "perf": "node scripts/perf-summary.mjs",
    "test:stage": "cross-env ENV=stage playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "test:smoke": "cross-env ENV=local playwright test --grep @smoke",
    "test:regression": "cross-env ENV=local playwright test --grep @regression",
    "test:e2e": "cross-env ENV=local playwright test tests/e2e",
    "test:orders": "cross-env ENV=local playwright test tests/e2e/orders",
    "test:api": "cross-env ENV=local playwright test --project=api",
    "auth": "cross-env ENV=local playwright test --project=portal-auth",
    "test:portal": "cross-env ENV=local playwright test --project=portal",
    "test:bulk": "cross-env ENV=local playwright test tests/regression/orders/bulkCreateOrders.regression.spec.ts",
    "test:headed": "cross-env ENV=local playwright test --headed",
    "test:ui": "cross-env ENV=local playwright test --ui",
    "test:debug": "cross-env ENV=local PWDEBUG=1 playwright test",
    "test:trace": "playwright show-trace",
    "report": "playwright show-report reports/html",
    "report:fast": "playwright show-report reports/html-fast",
    "report:serial": "playwright show-report reports/html-serial",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "report:allure:serve": "allure serve reports/allure-results",
    "codegen": "playwright codegen http://localhost:1420",
    "clean": "rimraf reports test-results \"test-results-*\" playwright-report"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
